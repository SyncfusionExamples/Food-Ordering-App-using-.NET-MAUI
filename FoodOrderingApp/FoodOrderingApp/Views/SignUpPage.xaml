<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodOrderingApp.Models"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="FoodOrderingApp.Views.SignUpPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">

    <Grid RowDefinitions="*" ColumnDefinitions="*,*" Padding="0" RowSpacing="0">
        <BoxView Grid.Row="0" Grid.Column="0" BackgroundColor="{StaticResource PrimaryColor}" IsVisible="{OnPlatform Default=false, WinUI=true, MacCatalyst=true}"/>
        <VerticalStackLayout Grid.Row="0" Grid.Column="0" IsVisible="{OnPlatform Default=false, WinUI=true, MacCatalyst=true}" Padding="30" Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="🍔" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="CraveDash" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
            <Label Text="Join us today" FontSize="18" TextColor="White" HorizontalOptions="Center" Opacity="0.8"/>
        </VerticalStackLayout>
        <ScrollView Grid.Row="0" Grid.Column="{OnPlatform Default=0, WinUI=1, MacCatalyst=1}">
            <VerticalStackLayout Padding="20" Spacing="14" VerticalOptions="Center">
                <VerticalStackLayout Spacing="8" Margin="0,0,0,20">
                    <Label Text="Create Account" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                    <Label Text="Sign up to start ordering" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" Stroke="#FF6B6B" BackgroundColor="#FFE0E0" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label Text="{Binding ErrorMessage}" TextColor="#CC0000" FontSize="12"/>
                </Border>
                <VerticalStackLayout Spacing="8">
                    <inputLayout:SfTextInputLayout Hint="Full Name" ReserveSpaceForAssistiveLabels="False" ContainerBackground="#f3f3f6" ContainerType="Filled">
                        <Entry x:Name="FullNameEntry" Text="{Binding FullName}" Placeholder="Enter your full name" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource EntryStyle}" />
                    </inputLayout:SfTextInputLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <inputLayout:SfTextInputLayout Hint="Email Address" ReserveSpaceForAssistiveLabels="False" ContainerBackground="#f3f3f6" ContainerType="Filled">
                        <Entry x:Name="EmailEntry" Text="{Binding Email}" Placeholder="Enter your email" Keyboard="Email" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource EntryStyle}" />
                    </inputLayout:SfTextInputLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <inputLayout:SfTextInputLayout Hint="Password" HasError="True" ErrorText="Minimum 8 characters" ContainerBackground="#f3f3f6" ContainerType="Filled" EnablePasswordVisibilityToggle="True">
                        <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Enter your password" Keyboard="Default" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource EntryStyle}" />
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle FontSize="11" TextColor="{AppThemeBinding Light=#999999, Dark=#999999}"></inputLayout:LabelStyle>
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    </inputLayout:SfTextInputLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <inputLayout:SfTextInputLayout Hint="Confirm Password" ReserveSpaceForAssistiveLabels="False" ContainerBackground="#f3f3f6" ContainerType="Filled" EnablePasswordVisibilityToggle="True">
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Re-enter your password" Keyboard="Default" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource EntryStyle}" />
                    </inputLayout:SfTextInputLayout>
                </VerticalStackLayout>
                <Button Text="Create Account" Command="{Binding SignUpCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="{StaticResource PrimaryColor}" TextColor="White" FontSize="16" FontAttributes="Bold" Padding="0,12" CornerRadius="8" Margin="0,10,0,0"/>
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource PrimaryColor}" Margin="0,10"/>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                    <Label Text="Already have an account? " FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"/>
                    <Label Text="Sign In" Padding="10,0,0,0" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource SecondaryColor}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
