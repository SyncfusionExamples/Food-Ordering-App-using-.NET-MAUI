<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodOrderingApp.Models"
             x:Class="FoodOrderingApp.Views.CheckoutPopup"
             Title="Checkout"
             BackgroundColor="Transparent"
             Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="*" Padding="0" RowSpacing="0">
        <BoxView Grid.Row="0" Color="Black" Opacity="0.5">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelCommand}"/>
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="{OnPlatform Default=340, WinUI=500, MacCatalyst=700}" StrokeShape="RoundRectangle 16" Padding="0" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">
            <Border.Shadow>
                <Shadow Brush="#26000000" Offset="0,4" Radius="8" Opacity="0.25"/>
            </Border.Shadow>
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="20">
                    <HorizontalStackLayout HorizontalOptions="End">
                        <Button Text="✕" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" FontSize="20" Padding="0" WidthRequest="40" HeightRequest="40"/>
                    </HorizontalStackLayout>
                    <Label Text="Complete Your Payment" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                    <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" Stroke="#FF6B6B" BackgroundColor="#FFE0E0" StrokeShape="RoundRectangle 8" Padding="12">
                        <Label Text="{Binding ErrorMessage}" TextColor="#CC0000" FontSize="12"/>
                    </Border>
                    <Border IsVisible="{Binding ShowSuccessMessage}" Stroke="#16A34A" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 8" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="✓ Payment Successful"  TextColor="#16A34A" FontSize="13" FontAttributes="Bold"/>
                            <Label Text="{Binding SuccessMessage}" TextColor="#16A34A" FontSize="12" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Stroke="{StaticResource PrimaryColor}" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" StrokeShape="RoundRectangle 8" Padding="12">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Total Amount" FontSize="12" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalAmount, StringFormat='₹{0:F2}'}" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Select Payment Method" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" Margin="0,8,0,0"/>
                    <Border x:Name="UPIFrame" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" StrokeShape="RoundRectangle 8" Padding="12">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox IsChecked="True" VerticalOptions="Center" CheckedChanged="OnUPISelected"/>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="💳 UPI" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                                <Label Text="Pay with UPI ID" FontSize="11" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="NetBankingFrame" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" StrokeShape="RoundRectangle 8" Padding="12">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox IsChecked="False" VerticalOptions="Center" CheckedChanged="OnNetBankingSelected"/>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="🏦 Net Banking" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                                <Label Text="Direct bank transfer" FontSize="11" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="CreditCardFrame" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" StrokeShape="RoundRectangle 8" Padding="12">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox IsChecked="False" VerticalOptions="Center" CheckedChanged="OnCreditCardSelected"/>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="💰 Credit Card" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                                <Label Text="Visa, MasterCard, Amex" FontSize="11" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="DebitCardFrame" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" StrokeShape="RoundRectangle 8" Padding="12">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox IsChecked="False" VerticalOptions="Center" CheckedChanged="OnDebitCardSelected"/>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="🏧 Debit Card" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                                <Label Text="All major banks" FontSize="11" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                    <Label FontSize="11" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="By proceeding, you agree to our "/>
                                <Span Text="Terms &amp; Conditions" TextColor="{StaticResource SecondaryColor}" TextDecorations="Underline"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Border IsVisible="{Binding PaymentProcessing}" Stroke="Transparent" Padding="0" StrokeShape="RoundRectangle 0" BackgroundColor="#80000000" Margin="-20,-40,-20,-20">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource PrimaryColor}" Scale="1.5"/>
                            <Label Text="Processing Payment..."  TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8" Margin="0,8,0,0" IsVisible="{Binding ShowSuccessMessage, Converter={StaticResource InvertedBoolConverter}}">
                        <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" FontSize="14" FontAttributes="Bold" Padding="0,12" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Confirm Payment" Command="{Binding ConfirmPaymentCommand}" IsEnabled="{Binding PaymentProcessing, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="{StaticResource PrimaryColor}" TextColor="White" FontSize="14" FontAttributes="Bold" Padding="0,12" CornerRadius="8"/>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
