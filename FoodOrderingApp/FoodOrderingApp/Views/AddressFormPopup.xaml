<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodOrderingApp.Views.AddressFormPopup"
             xmlns:models="clr-namespace:FoodOrderingApp.Models"
             Title="Add Address"
             BackgroundColor="Transparent">

    <!-- Outer Container for Semi-transparent Background -->
    <Grid RowDefinitions="*" ColumnDefinitions="*" 
          BackgroundColor="#00000080" 
          Padding="0"
          Margin="-20"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">

        <!-- Modal Card -->
        <Border Grid.Row="0"
               Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
               StrokeShape="RoundRectangle 16"
               Padding="20"
               Margin="20,100,20,100"
               VerticalOptions="Center"
               HorizontalOptions="Fill">
            <Border.Shadow>
                <Shadow Brush="#26000000" Offset="0,4" Radius="8" Opacity="0.25"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" 
                           Text="{Binding IsEditMode, StringFormat='{0:ischecked=Edit Address,ischecked=Add New Address}'}"
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                           VerticalOptions="Center"/>

                    <Button Grid.Column="1"
                            Text="✕"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                            FontSize="18"
                            Padding="4"
                            CornerRadius="0"/>
                </Grid>

                <!-- Error Message -->
                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                       Stroke="#FF6B6B" 
                       BackgroundColor="#FFE0E0" 
                       StrokeShape="RoundRectangle 8" 
                       Padding="12" 
                       Margin="0">
                    <Label Text="{Binding ErrorMessage}" 
                           TextColor="#CC0000" 
                           FontSize="12"/>
                </Border>

                <!-- Address Label -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Label (e.g., Home, Office)" 
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    <Entry Placeholder="Enter address label"
                           Text="{Binding CurrentAddress.Label}"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                           PlaceholderColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                           Margin="8,10"/>
                </VerticalStackLayout>

                <!-- Street Address -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Street Address" 
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    <Entry Placeholder="Enter street address"
                           Text="{Binding CurrentAddress.Street}"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                           PlaceholderColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                           Margin="8,10"/>
                </VerticalStackLayout>

                <!-- City & State Grid -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <!-- City -->
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="City" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Entry Placeholder="Enter city"
                               Text="{Binding CurrentAddress.City}"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                               TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                               PlaceholderColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                               Margin="8,10"/>
                    </VerticalStackLayout>

                    <!-- State -->
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="State" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Entry Placeholder="Enter state"
                               Text="{Binding CurrentAddress.State}"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                               TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                               PlaceholderColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                               Margin="8,10"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Postal Code -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Postal Code" 
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    <Entry Placeholder="Enter postal code"
                           Text="{Binding CurrentAddress.PostalCode}"
                           Keyboard="Numeric"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                           PlaceholderColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                           Margin="8,10"/>
                </VerticalStackLayout>

                <!-- Location Grid -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <!-- Latitude -->
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Latitude" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Entry Placeholder="Latitude"
                               Text="{Binding CurrentAddress.Latitude, StringFormat='{0:F6}'}"
                               Keyboard="Numeric"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                               TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                               PlaceholderColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                               Margin="8,10"/>
                    </VerticalStackLayout>

                    <!-- Longitude -->
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Longitude" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Entry Placeholder="Longitude"
                               Text="{Binding CurrentAddress.Longitude, StringFormat='{0:F6}'}"
                               Keyboard="Numeric"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                               TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                               PlaceholderColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                               Margin="8,10"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Map Selection Info -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                       StrokeShape="RoundRectangle 8"
                       Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="📍 Location Info" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryColor}"/>
                        <Label Text="Enter latitude and longitude coordinates. You can get these from Google Maps or other mapping services."
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                            TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="0,12"
                            CornerRadius="8"/>

                    <Button Grid.Column="1"
                            Text="{Binding IsEditMode, StringFormat='{0:ischecked=Update Address,ischecked=Add Address}'}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="0,12"
                            CornerRadius="8"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
