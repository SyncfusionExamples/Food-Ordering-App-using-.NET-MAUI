<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodOrderingApp.Models"
             xmlns:local="clr-namespace:FoodOrderingApp.ViewModels"
             x:Class="FoodOrderingApp.Views.CartPage"
             Title="CraveDash"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Label Text="Your Cart" Grid.Row="0" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" Padding="16,16,16,0" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Padding="0">
            <CollectionView ItemsSource="{Binding CartItems}" SelectionMode="None" VerticalScrollBarVisibility="Never" Margin="12,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:CartItemViewModel">
                        <Border Padding="12" StrokeShape="RoundRectangle 12" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="60,*,80" RowSpacing="12" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Border StrokeThickness="0" Grid.Column="0" HeightRequest="60" VerticalOptions="Center" WidthRequest="60">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding Item.Image}" Aspect="AspectFill"/>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding RestaurantName}" FontSize="14" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding UnitPrice, StringFormat='₹{0:F2} per item'}" FontSize="13" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="{Binding Total, StringFormat='₹{0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="End"/>
                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontSize="13" TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}" HorizontalOptions="End"/>
                                    <Button Text="Remove" Command="{Binding RemoveCommand}" CommandParameter="{Binding .}" WidthRequest="70" HeightRequest="25" BackgroundColor="Transparent" TextColor="#DC2626" FontSize="11" Padding="0,4" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20" Spacing="16">
                        <Label Text="🛒" FontSize="64" HorizontalOptions="Center"/>
                        <Label Text="Your cart is empty" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" HorizontalTextAlignment="Center"/>
                        <Label Text="Add items to get started" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" HorizontalTextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Text="Continue Shopping" WidthRequest="500" Command="{Binding ContinueShoppingCommand}" BackgroundColor="{StaticResource PrimaryColor}" TextColor="White" FontSize="14" Padding="0,12" CornerRadius="8" Margin="20,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource PrimaryColor}"/>
        </Grid>
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsCartEmpty, Converter={StaticResource InvertedBoolConverter}}" Padding="16" Spacing="12" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#222222}">
            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Subtotal:" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='₹{0:F2}'}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Tax (18% GST):" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                <Label Grid.Column="1" Text="{Binding Tax, StringFormat='₹{0:F2}'}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Delivery Fee:" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                <Label Grid.Column="1" Text="{Binding DeliveryFee, StringFormat='₹{0:F2}'}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#444444}" Margin="0,4"/>
            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Total:" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                <Label Grid.Column="1" Text="{Binding Total, StringFormat='₹{0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/>
            </Grid>
            <Button Text="Proceed to Checkout" WidthRequest="500" Command="{Binding CheckoutCommand}" BackgroundColor="{StaticResource PrimaryColor}" TextColor="White" FontSize="16" FontAttributes="Bold" Padding="0,12" CornerRadius="8" Margin="0,8,0,0"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
