<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodOrderingApp.Models"
             xmlns:local="clr-namespace:FoodOrderingApp.ViewModels"
             x:Class="FoodOrderingApp.Views.CartPage"
             Title="Shopping Cart"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">

    <Grid RowDefinitions="*,Auto">
        
        <!-- Cart Items List -->
        <VerticalStackLayout Grid.Row="0" Spacing="0" Padding="0">
            
            <!-- Header -->
            <Label Text="Your Cart" FontSize="22" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                   Padding="16,16,16,0" Margin="0,0,0,12"/>

            <!-- Items List -->
            <CollectionView ItemsSource="{Binding CartItems}"
                           SelectionMode="None"
                           Margin="12,0">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:CartItemViewModel">
                        
                        <!-- Cart Item Card -->
                        <Border Padding="12" StrokeShape="RoundRectangle 12"
                               Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                               BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}"
                               Margin="0,0,0,12">
                            
                            <Grid ColumnDefinitions="60,*,80" RowSpacing="12" ColumnSpacing="12">
                                
                                <!-- Item Image -->
                                <Image Grid.Column="0"
                                       Source="{Binding Item.Image, StringFormat='https://via.placeholder.com/60x60?text={0}'}"
                                       Aspect="AspectFill"
                                       HeightRequest="60"
                                       WidthRequest="60"/>

                                <!-- Item Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Text="{Binding RestaurantName}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Text="{Binding UnitPrice, StringFormat='₹{0:F2} per item'}"
                                           FontSize="12"
                                           TextColor="{StaticResource PrimaryColor}"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <!-- Price and Remove -->
                                <VerticalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                                    
                                    <Label Text="{Binding Total, StringFormat='₹{0:F2}'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryColor}"
                                           HorizontalOptions="End"/>

                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"
                                           HorizontalOptions="End"/>

                                    <Button Text="Remove"
                                            Command="{Binding RemoveCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#DC2626"
                                            FontSize="11"
                                            Padding="0,4"
                                            HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Empty State -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20" Spacing="16">
                        <Label Text="🛒" FontSize="64" HorizontalOptions="Center"/>
                        <Label Text="Your cart is empty" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Add items to get started" FontSize="13"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,12"/>
                        <Button Text="Continue Shopping"
                                Command="{Binding ContinueShoppingCommand}"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                FontSize="14"
                                Padding="0,12"
                                CornerRadius="8"
                                Margin="20,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                              IsVisible="{Binding IsLoading}"
                              Color="{StaticResource PrimaryColor}"/>
        </VerticalStackLayout>

        <!-- Order Summary and Checkout -->
        <VerticalStackLayout Grid.Row="1" 
                            IsVisible="{Binding IsCartEmpty, Converter={StaticResource InvertedBoolConverter}}"
                            Padding="16" Spacing="12"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#222222}">

            <!-- Summary Items -->
            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Subtotal:" FontSize="13"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='₹{0:F2}'}"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Tax (18% GST):" FontSize="13"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                <Label Grid.Column="1" Text="{Binding Tax, StringFormat='₹{0:F2}'}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Delivery Fee:" FontSize="13"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                <Label Grid.Column="1" Text="{Binding DeliveryFee, StringFormat='₹{0:F2}'}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#444444}" Margin="0,4"/>

            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Grid.Column="0" Text="Total:" FontSize="14" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}"/>
                <Label Grid.Column="1" Text="{Binding Total, StringFormat='₹{0:F2}'}"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryColor}"/>
            </Grid>

            <!-- Checkout Button -->
            <Button Text="Proceed to Checkout"
                    Command="{Binding CheckoutCommand}"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="0,12"
                    CornerRadius="8"
                    Margin="0,8,0,0"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
