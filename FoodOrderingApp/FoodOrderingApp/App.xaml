<?xml version = "1.0" encoding = "UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:FoodOrderingApp.Converters"
    x:Class="FoodOrderingApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Light Theme Colors -->
            <Color x:Key="PrimaryColor">#FF6B35</Color>
            <Color x:Key="SecondaryColor">#004E89</Color>
            <Color x:Key="TertiaryColor">#F7B801</Color>
            <Color x:Key="DarkTextColor">#1E1E1E</Color>
            <Color x:Key="LightTextColor">#FFFFFF</Color>
            <Color x:Key="LightBackground">#FFFFFF</Color>
            <Color x:Key="DarkBackground">#1E1E1E</Color>
            <Color x:Key="LightBackgroundColor">#FFFFFF</Color>
            <Color x:Key="DarkBackgroundColor">#1E1E1E</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="ErrorColor">#DC2626</Color>
            <Color x:Key="SuccessColor">#16A34A</Color>
            <Color x:Key="WarningColor">#EA580C</Color>

            <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
            <Color x:Key="TextColor">#1E1E1E</Color>
            <Color x:Key="TextColorSecondary">#666666</Color>


            <!-- Light/Dark Adaptive Colors -->
            <Style TargetType="ContentPage" x:Key="PageStyle">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}" />
            </Style>
            <Style TargetType="Label" x:Key="PrimaryTextStyle">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" />
            </Style>
            <Style TargetType="Label" x:Key="SecondaryTextStyle">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
            </Style>

            <!-- Font Sizes -->
            <x:Double x:Key="FontSizeSmall">12</x:Double>
            <x:Double x:Key="FontSizeNormal">14</x:Double>
            <x:Double x:Key="FontSizeLarge">18</x:Double>
            <x:Double x:Key="FontSizeXLarge">24</x:Double>
            <x:Double x:Key="FontSizeTitle">28</x:Double>

            <!-- Spacing -->
            <Thickness x:Key="PaddingSmall">8</Thickness>
            <Thickness x:Key="PaddingNormal">16</Thickness>
            <Thickness x:Key="PaddingLarge">24</Thickness>

            <!-- Button Style -->
            <Style TargetType="Button" x:Key="PrimaryButtonStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="{StaticResource LightTextColor}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
                <Setter Property="Padding" Value="{StaticResource PaddingNormal}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Entry Style -->
            <Style TargetType="Entry" x:Key="InputEntryStyle">
                <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkTextColor}, Dark={StaticResource LightTextColor}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
            </Style>

            <!-- Label Style -->
            <Style TargetType="Label" x:Key="HeadingLabelStyle">
                <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
            </Style>

            <!-- Entry Style (General) -->
            <Style TargetType="Entry" x:Key="EntryStyle">
                <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"/>
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextColorSecondary}" />
            </Style>

            <!-- Value Converters -->
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
